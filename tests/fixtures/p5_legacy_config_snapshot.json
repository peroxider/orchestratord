{
  "tracker": {
    "kind": "github",
    "endpoint": "https://github.example/api",
    "api_key": "gh-token",
    "project_slug": null,
    "owner": "example-owner",
    "repo": "example-repo",
    "clone_url": "https://github.example/example-owner/example-repo.git",
    "assignee": "agent-bot",
    "branch_prefix": "agent/",
    "issues_path": null,
    "active_states": [
      "open",
      "in progress"
    ],
    "terminal_states": [
      "closed"
    ],
    "skip_labels": [
      "wip"
    ],
    "require_any_labels": [
      "agent-ok"
    ],
    "title_prefixes": [
      "[agent]"
    ],
    "title_prefix_match": "any"
  },
  "polling": {
    "interval_ms": 12345
  },
  "workspace": {
    "root": "/tmp/p5-fixture-ws",
    "hooks": {
      "after_create": "echo hi"
    },
    "repo_clone_url": "https://github.example/example-owner/example-repo.git",
    "upstream_clone_url": null,
    "clone_depth": 2,
    "checkout_issue_branch": false,
    "git_username": "bot",
    "git_email": "bot@example.dev",
    "git_token": "tok",
    "gitignore_patterns": [
      ".secret"
    ],
    "strategy": "isolated",
    "base_branch": "develop",
    "integration_branch": "staging",
    "require_clean_start": false,
    "require_clean_between_issues": false,
    "preserve_on_terminal": false,
    "preserve_on_failure": false,
    "preserve_on_abandoned": false,
    "preserve_on_timeout": false,
    "sequential_lock": false,
    "python_executable": "",
    "python_auto_detect": true,
    "python_detect_files": [
      ".python-version",
      "pyvenv.cfg",
      ".venv/pyvenv.cfg",
      "Pipfile",
      "environment.yml"
    ]
  },
  "worker": {
    "ssh_hosts": [
      "host-a"
    ],
    "max_concurrent_agents_per_host": 2
  },
  "agent": {
    "max_concurrent_agents": 3,
    "max_turns": 42,
    "max_retry_backoff_ms": 1000,
    "max_retry_attempts": 2,
    "max_turns_retry_delay_ms": 500,
    "max_concurrent_agents_by_state": {
      "review": 2
    },
    "provider": "dsh",
    "permission_mode": "bypassPermissions",
    "audit_log": "minimal",
    "test_command": "pytest -q",
    "build_command": "make build",
    "lint_command": "ruff check",
    "verification": {
      "timeout_ms": 5000,
      "regression_guard": false,
      "fallback_test_command": "pytest -x"
    },
    "repro_first": {
      "enabled": true,
      "timeout_ms": 1000,
      "command_timeout_ms": 2000,
      "labels": [
        "bug"
      ]
    },
    "max_retries_per_issue": 7,
    "allow_anyone_to_retry": true,
    "model": "m-main",
    "model_aliases": {},
    "base_url": "https://llm.example",
    "api_key": "llm-key",
    "cordis": null,
    "runtime_bin": null,
    "stage_overrides": {
      "implementer": {
        "model": "m-impl"
      },
      "tester": {
        "provider": "p2",
        "model": "m-test"
      }
    },
    "providers": {},
    "rate_limit_base_delay_ms": 100,
    "rate_limit_max_backoff_ms": 200,
    "rate_limit_exponential_factor": 3.0,
    "rate_limit_max_retries": 9,
    "delay_between_requests_ms": 250,
    "run_timeout_ms": 111000,
    "stall_timeout_ms": 222000,
    "first_turn_timeout_ms": 0,
    "stall_warn_ms": 33000,
    "allowed_changed_files": [
      "src/**"
    ],
    "review_required": true,
    "auto_approve": false,
    "coordinator_mode": false,
    "max_no_op_turns": 4,
    "loop_detection_window": 6,
    "loop_detection_threshold": 2,
    "perf_should_continue_skip_turns": 3,
    "phases": [
      "plan",
      "code"
    ],
    "fallback_to_phase_step": true,
    "max_tools_per_turn": 10,
    "python_executable": "python3.12",
    "env": {
      "APP_MODE": "test"
    },
    "clarification_enabled": false,
    "clarification_timeout_local": 60.0,
    "clarification_timeout_author": 3600.0,
    "max_questions_per_issue": 5,
    "clarification_operator_priority": false,
    "clarification_simultaneous_grace_ms": 1500.0,
    "clarification_escalation": "escalate"
  },
  "sandbox": {
    "command": "codex-cli",
    "approval_policy": "never",
    "thread_sandbox": "workspace-write",
    "turn_sandbox_policy": {
      "type": "workspaceWrite"
    },
    "turn_timeout_ms": 999,
    "read_timeout_ms": 11,
    "stall_timeout_ms": 222
  },
  "hooks": {
    "after_create": null,
    "before_run": "echo before",
    "after_run": "echo after",
    "before_remove": null,
    "pre_commit": null,
    "pre_push": null,
    "post_sync": null,
    "timeout_ms": 1234
  },
  "review_feedback": {
    "enabled": true,
    "mode": "auto",
    "poll_interval_ms": 7000,
    "max_feedback_items_per_run": 9,
    "include_ci_failures": false,
    "reply_to_comments": false,
    "ignore_authors": [
      "bot-x"
    ],
    "ignored_comment_commands": [
      "/noop"
    ],
    "ignored_feedback_sources": [
      "ci"
    ],
    "ignored_body_patterns": [
      "nit"
    ],
    "bot_login": "review-bot",
    "max_log_chars_per_check": 500,
    "max_followup_attempts_per_pr": 2,
    "pending_feedback_timeout_seconds": 60
  },
  "rules": {
    "enabled": true,
    "path": "rules.md",
    "max_rules": 5,
    "min_confidence": "high"
  },
  "experience": {
    "enabled": false,
    "friction_threshold_distill": 60,
    "friction_threshold_learnings": 40,
    "percentile_window": 20,
    "privacy_allowlist": []
  },
  "telemetry": {
    "reporting_enabled": true,
    "report_owner": "tel-owner",
    "report_repo": "tel-repo",
    "issue_title": "Tel",
    "api_key": "tel-key",
    "env_label": "prod",
    "backfill_days": 1
  },
  "observability": {
    "dashboard_enabled": false,
    "refresh_ms": 500,
    "render_interval_ms": 32
  },
  "server": {
    "port": 9443,
    "host": "0.0.0.0"
  },
  "modes": {
    "enabled": [
      "single",
      "pipeline"
    ],
    "default": "pipeline",
    "router_kind": "heuristic",
    "router_model": "deepseek-v4-flash",
    "router_endpoint": "https://api.deepseek.com/chat/completions",
    "router_api_key_env": "DEEPSEEK_API_KEY",
    "router_timeout_seconds": 9.0,
    "router_min_confidence": 0.6,
    "pipeline_stages": [
      "analyzer",
      "tester"
    ],
    "pipeline_max_retries_per_stage": 2,
    "pipeline_stage_models": {
      "analyzer": "m-a"
    },
    "pipeline_stage_max_turns": {
      "tester": 7
    },
    "pipeline_stage_specs": {
      "tester": {
        "kind": "debate",
        "config": {
          "proposers": [
            "a",
            "b"
          ]
        }
      }
    },
    "pipeline_handoff": "mailbox",
    "debate_proposers": [
      "x",
      "y"
    ],
    "debate_judge_model": "m-judge",
    "debate_judge_mode": "synthesize",
    "debate_proposer_models": {
      "x": "m-x"
    },
    "debate_isolation": "worktree",
    "debate_parallel": true,
    "swarm_max_subtasks": 4,
    "swarm_max_parallel": 2,
    "swarm_max_waves": 3
  },
  "pr_template": {
    "title": "PR: {{title}}",
    "body": "Auto body"
  },
  "pr_conflict_scan": {
    "enabled": true,
    "poll_interval_ms": 1000,
    "max_rebase_attempts_per_issue": 2,
    "max_prs_per_scan": 10,
    "use_force_push": true,
    "bot_login": "scan-bot",
    "scan_states": [
      "open",
      "draft"
    ]
  },
  "clarifier": {
    "enabled": true,
    "block_on_unclear": false,
    "author_first": false,
    "max_questions": 2,
    "max_rounds": 3,
    "min_confidence": 0.9,
    "max_input_tokens": 7000,
    "max_output_tokens": 900,
    "fail_open": false,
    "cache_enabled": false,
    "max_analyses_per_poll": 2,
    "workspace_focus_enabled": false,
    "remote_label": ""
  },
  "source_path": ""
}
